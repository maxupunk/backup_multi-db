# =============================================================================
# .dockerignore - DB Backup Manager
# Build context: project root (..)
# =============================================================================

# --- Dependências (platform-native, devem ser compiladas dentro do container)
node_modules/
frontend/node_modules/
backend/target/

# --- Builds locais
frontend/dist/
frontend/dev-dist/

# --- Git
.git/
.gitignore

# --- Logs
*.log

# --- Arquivos de ambiente (nunca enviar ao container)
.env
.env.*
!.env.example

# --- Dados locais (montados via volume)
backend/storage/backups/
backend/storage/database/
backend/storage/diagnostics/

# --- SQLite de desenvolvimento/teste. Sao gitignored, mas o .dockerignore e'
#     independente: sem estas linhas eles entram no contexto e qualquer
#     execucao local do backend invalida a camada do `planner`, forcando um
#     `cargo chef prepare` novo a cada build.
backend/*.sqlite
backend/*.sqlite3
backend/*.sqlite-shm
backend/*.sqlite-wal
backend/*.sqlite3-shm
backend/*.sqlite3-wal

# --- Editores / IDEs
.vscode/
.idea/
*.swp
*.swo

# --- OS
.DS_Store
Thumbs.db
