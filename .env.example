# =============================================================================
# Modelo do .env local. Copie para `.env` e preencha.
# =============================================================================
#
# Quem lê o `.env` é o **docker compose**, de duas formas: para interpolar
# `${VAR}` nos compose files e como `env_file` do container.
#
# O `cargo loco start` NÃO lê `.env` — o Loco não carrega esse arquivo. Rodando
# o backend direto da máquina, valem os defaults de
# `backend/config/development.yaml` ou o que estiver exportado no shell.
# =============================================================================

# --- Geral -------------------------------------------------------------------
# PORT = porta interna do processo (o compose fixa BINDING e PORT)
# ROCO_EXTERNAL_PORT = porta publicada no host pelo docker-compose.dev.yml
TZ=America/Sao_Paulo
PORT=3333
ROCO_EXTERNAL_PORT=3355
LOG_LEVEL=info

# --- Criptografia das credenciais gravadas -----------------------------------
# 64 caracteres hex (32 bytes). É a entrada do HKDF que deriva a chave AES-256;
# não é a chave em si.
# Gere com: openssl rand -hex 32
#
# ATENÇÃO: trocar este valor torna ilegíveis todas as senhas de conexão e
# configs de storage já gravadas. O default de `development.yaml` é um valor
# público de teste e diferente deste — alternar entre compose e
# `cargo loco start` sem exportar a mesma variável no shell alterna entre duas
# chaves, e uma não lê o que a outra gravou.
DB_ENCRYPTION_KEY=

# --- Autenticação ------------------------------------------------------------
# Segredo que assina o JWT de sessão. Precisa ser base64 válido.
# OBRIGATÓRIO em produção: o `production.yaml` não tem default, e sem a variável
# o processo não sobe.
# Gere com: openssl rand -base64 48 | tr -d '\n'
#
# NÃO deixe vazio. Uma variável definida como string vazia NÃO cai no default do
# YAML — o `get_env` do Tera devolve a string vazia, e o JWT passa a ser
# assinado com uma chave HMAC de comprimento zero: qualquer um forja um token
# válido, em silêncio. Para usar o default de desenvolvimento, comente a linha.
JWT_SECRET=

# Vida do token, em segundos. Como o JWT não pode ser revogado, este é o único
# limite sobre quanto tempo um token vazado continua servindo. 604800 = 7 dias.
# Trocar o JWT_SECRET é o botão de "deslogar todo mundo".
JWT_EXPIRATION=604800

# Exigido para criar o PRIMEIRO administrador quando LOCO_ENV=production.
# Fora de produção o primeiro cadastro dispensa o token — mas se o valor estiver
# preenchido, ele passa a ser exigido em qualquer ambiente.
INITIAL_ADMIN_BOOTSTRAP_TOKEN=

# --- Backup ------------------------------------------------------------------
# Quando true, remove a cópia local após upload remoto bem-sucedido para
# S3/R2/GCS/Azure/SFTP. Nasce desligado: manter as duas cópias é o que permite
# restaurar sem rede.
BACKUP_DELETE_LOCAL_AFTER_REMOTE_UPLOAD=false

# --- Auditoria ---------------------------------------------------------------
# Dias de retenção dos logs de auditoria. 0 desliga a poda (a tabela cresce sem
# limite). O log serve para diagnóstico recente, não como registro histórico:
# a faixa útil é 15 a 30 dias.
AUDIT_RETENTION_DAYS=30

# --- Docker Manager ----------------------------------------------------------
# ID do container do backend, para excluí-lo das métricas de recursos.
# Obtenha com: docker inspect --format='{{.Id}}' <nome-do-container>
BACKEND_CONTAINER_ID=

# IP do host Docker, usado para sugerir endereços de conexão a partir dos
# containers vistos na Engine. Vazio deixa a heurística decidir.
DOCKER_HOST_IP=
DOCKER_FALLBACK_HOST=

# Nome do projeto compose (essencial para rodar mais de uma instância no mesmo servidor sem conflito de volumes)
# COMPOSE_PROJECT_NAME=db-backup-rust

# =============================================================================
# A política de retenção GFS (diário/semanal/mensal/anual e o cron da poda) NÃO
# fica aqui: é editada pela tela de configurações e guardada na tabela
# `system_settings`.
#
# `BACKUP_STORAGE_PATH`, `DIAGNOSTICS_PATH` e `DATABASE_URL` são fixados pelo
# compose (apontam para os volumes) — não precisam estar no `.env`.
# =============================================================================
