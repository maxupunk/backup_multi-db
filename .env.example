# Timezone e configurações gerais
# PORT = porta interna da aplicação (o binding é fixado em BINDING pelo compose)
# ROCO_EXTERNAL_PORT = porta publicada no host pelo docker-compose.dev.yml
TZ=America/Sao_Paulo
PORT=3333
ROCO_EXTERNAL_PORT=3355
LOG_LEVEL=info

# Chave para criptografia das senhas dos bancos de dados
# IMPORTANTE: Use uma chave forte de 64 caracteres hex (32 bytes) para AES-256
# Gere com: openssl rand -hex 32
DB_ENCRYPTION_KEY=

# Autenticacao
# Segredo que assina o JWT de sessão. OBRIGATÓRIO em produção — sem ele o
# processo não sobe. Precisa ser base64 válido; gere com:
#   openssl rand -base64 48 | tr -d '\n'
# Trocar o valor invalida todas as sessões abertas, o que é a forma de
# "deslogar todo mundo" num modelo sem revogação por token.
JWT_SECRET=
# Vida do token, em segundos. Como o JWT não pode ser revogado, este é o único
# limite sobre quanto tempo um token vazado continua servindo. Padrão: 7 dias.
JWT_EXPIRATION=604800
# Obrigatorio para o primeiro cadastro em producao
INITIAL_ADMIN_BOOTSTRAP_TOKEN=

# Docker Manager
# ID do container backend (necessário para excluir o próprio container das métricas)
# Obtenha com: docker inspect --format='{{.Id}}' <nome-do-container>
BACKEND_CONTAINER_ID=

# Backup
# Quando true, remove a cópia local após upload remoto bem-sucedido para S3/R2/GCS/Azure/SFTP
BACKUP_DELETE_LOCAL_AFTER_REMOTE_UPLOAD=false

# Auditoria
# Dias de retenção dos logs de auditoria. A poda roda junto com o prune diário
# de backups. Use 0 para desligar (a tabela cresce indefinidamente).
#
# O log serve para diagnóstico recente, não como registro histórico:
# a faixa útil é 15 a 30 dias. Valores maiores só fazem o SQLite crescer.
AUDIT_RETENTION_DAYS=30
# Diretório dos artefatos de diagnóstico (.heapsnapshot / .cpuprofile /
# .heapprofile) listados e baixados pelo painel. Precisa ser um volume, senão
# os arquivos somem no restart do container.
DIAGNOSTICS_PATH=/storage/diagnostics
