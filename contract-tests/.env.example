# Todas as variaveis sao opcionais — os defaults estao em `src/config.ts`.
# Este arquivo nao e' lido automaticamente; exporte no shell ou use o CI.

# Implementacao sob teste.
CONTRACT_TARGET=adonis

# Aponta a suite para um servidor JA' rodando. Definir isto desliga o
# gerenciamento do servidor pelo harness — e, com ele, o banco descartavel e o
# reset do rate limiter. Use so' para depurar.
# CONTRACT_BASE_URL=http://127.0.0.1:3333

# Sobe/derruba o servidor. Default: true, exceto se CONTRACT_BASE_URL existir.
# CONTRACT_MANAGE_SERVER=1

# Porta do servidor sob teste. 0 = escolhe uma porta livre automaticamente.
CONTRACT_PORT=0

# off | record | compare
CONTRACT_GOLDEN=compare

# Reprova a execucao se alguma rota do baseline ficar sem teste (tarefa 1.8).
CONTRACT_ENFORCE_COVERAGE=0

# Emite reports/contract-diff.md com as divergencias de golden.
CONTRACT_DIFF_REPORT=0

CONTRACT_REQUEST_TIMEOUT_MS=30000
CONTRACT_BOOT_TIMEOUT_MS=120000
CONTRACT_RETRIES=2

# Nivel de log do servidor sob teste (vai para .contract/<run>/server.log).
CONTRACT_LOG_LEVEL=warn
